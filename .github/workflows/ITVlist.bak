name: Update IPTV Sources for Private Repo

on:
  schedule:
    - cron: '0 2 * * *' # 每天凌晨 2 点定时运行（可自行修改）
  workflow_dispatch:     # 支持手动点击运行

jobs:
  update-repo:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Public Repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install requests

      - name: Run Fetch Script
        run: |
          python py/fetch_sources.py

      - name: Push to Private Repo (linyubo211/tvlive)
        uses: cpina/github-action-push-to-another-repository@main
        env:
          API_TOKEN_GITHUB: ${{ secrets.MY_PAT_TOKEN }}
        with:
          source-directory: 'py'
          destination-github-username: 'linyubo211'
          destination-repository-name: 'tvlive'
          destination-directory: 'py'
          user-email: 'actions@github.com'
          user-name: 'GitHub Actions Bot'
          commit-message: '🔄 自动更新 1000.txt 源列表 [skip ci]'
          target-branch: 'main'
